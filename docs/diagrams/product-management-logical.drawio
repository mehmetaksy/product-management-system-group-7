<mxCell id="note" value="&lt;b&gt;Relational schema&lt;/b&gt;&lt;br&gt;Users(&lt;u&gt;user_id&lt;/u&gt;, username, password_hash, role)&lt;br&gt;Category(&lt;u&gt;category_id&lt;/u&gt;, name, description)&lt;br&gt;Supplier(&lt;u&gt;supplier_id&lt;/u&gt;, name, phone, email)&lt;br&gt;Product(&lt;u&gt;product_id&lt;/u&gt;, name, price, stock, &lt;i&gt;category_id&lt;/i&gt; → Category, &lt;i&gt;supplier_id&lt;/i&gt; → Supplier)&lt;br&gt;Orders(&lt;u&gt;order_id&lt;/u&gt;, &lt;i&gt;product_id&lt;/i&gt; → Product, &lt;i&gt;user_id&lt;/i&gt; → Users, customer_name, quantity, order_date)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;strokeColor=#999999;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="760" height="120" as="geometry"/></mxCell>
